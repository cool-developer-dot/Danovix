# DANOVIX Frontend — environment variables
# Copy to `.env.local` for local development.
# Set the same keys in the Vercel project settings for preview/production.

# Canonical site origin (no trailing slash). Used for metadata, sitemap, OG URLs.
NEXT_PUBLIC_SITE_URL=https://danovix.com

# Optional: enable experimental hero R3F placeholder path (default off).
# NEXT_PUBLIC_ENABLE_HERO_3D=false
